# Lincolnsoft Server – Caddy
# Quelle: Repo lincolnsoft-homestation/deploy/server/Caddyfile – deploy/update.sh übernimmt Änderungen
# automatisch nach ~/server/Caddyfile (vorher geprüft, Sicherung als Caddyfile.bak).
# Kein "log"-Eintrag: Caddy schreibt bewusst KEIN Zugriffsprotokoll.

www.lincolnsoft.de {
	redir https://lincolnsoft.de{uri} permanent
}

lincolnsoft.de {
	# Foto-Coach (/fotocoach/): Gemini-Proxy – hängt den Schlüssel aus GEMINI_API_KEY an
	# (~/.config/lincolnsoft/gemini.env), lässt nur generateContent auf Gemini-Modellen durch, alles andere -> 403
	handle_path /fotocoach/api/gemini/* {
		@gemini path_regexp ^/v1beta/models/gemini-[a-z0-9.\-]+:generateContent$
		handle @gemini {
			request_body {
				max_size 25MB
			}
			reverse_proxy https://generativelanguage.googleapis.com {
				header_up x-goog-api-key {env.GEMINI_API_KEY}
				header_up -Cookie
				header_up -Referer
			}
		}
		handle {
			respond 403
		}
	}

	# Steelrumble: Spielräume 1–4 (WebSocket) zum Container "steelrumble", Web-Version komprimiert ausliefern
	reverse_proxy /steelrumble/ws steelrumble:24556
	reverse_proxy /steelrumble/ws2 steelrumble:24557
	reverse_proxy /steelrumble/ws3 steelrumble:24558
	reverse_proxy /steelrumble/ws4 steelrumble:24559
	@steelrumble path /steelrumble/*
	encode @steelrumble zstd gzip

	# Kontaktformular + Aufrufzähler (Container "api", deploy/kontakt/kontakt.py)
	reverse_proxy /api/* api:8080

	root * /srv/site
	file_server
}
