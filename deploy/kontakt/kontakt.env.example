# Lincolnsoft Homestation – Kontaktformular
# Kopieren nach ~/.config/lincolnsoft/kontakt.env und Rechte setzen:  chmod 600 ~/.config/lincolnsoft/kontakt.env
# Diese Datei NIE ins Git-Repo legen – sie enthält dein App-Passwort.

# Gmail-Adresse, über die gesendet wird
SMTP_USER=
# Google-App-Passwort (myaccount.google.com/apppasswords, 2-Faktor muss an sein), 16 Zeichen ohne Leerzeichen
# Leer lassen = Formular antwortet "noch nicht aktiv – bitte per E-Mail"
SMTP_PASS=
# Empfänger (leer = SMTP_USER)
MAIL_TO=
# Zufälliger Schlüssel (optional, sonst bei jedem Start neu):  openssl rand -hex 32
SECRET=
# Nachrichten pro Tag insgesamt
DAILY_MAX=30

# Feedback-Übersicht fürs Handy: https://lincolnsoft.de/api/feedback/ansicht
# Leer = abgeschaltet. Langes Passwort wählen, z. B.:  openssl rand -base64 18
FEEDBACK_ADMIN_USER=admin
FEEDBACK_ADMIN_PASS=
