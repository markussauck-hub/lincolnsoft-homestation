# Lincolnsoft Homestation – News-Bot
# Kopieren nach ~/.config/lincolnsoft/news.env und Rechte setzen:  chmod 600 ~/.config/lincolnsoft/news.env
# Diese Datei NIE ins Git-Repo legen – sie enthält deinen API-Key.

# Welche KI: gemini | claude | none (none = nur Feed-Text, englisch)
NEWS_PROVIDER=gemini

# --- Gemini (Key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Claude (Key: https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Optional ---
# Feeds: "Name|URL" oder "Name|URL|Titel-Filter" mit ";" getrennt (RSS, Atom oder JSON Feed).
# Der Filter ist ein Regex auf den Titel – nur passende Meldungen kommen durch (für gemischte Feeds).
# NEWS_FEEDS=EVE News|https://www.eveonline.com/rss/news;Dev-Blog|https://www.eveonline.com/rss/dev-blogs;Patch Notes|https://www.eveonline.com/rss/patch-notes;EVE Online|https://www.eveonline.com/rss;Massively OP|https://massivelyop.com/tag/eve-online/feed/|\bEVE\b|New Eden|\bCCP\b
# NEWS_MAX_ITEMS=12
# NEWS_MAX_NEW_PER_RUN=8
# NEWS_MAX_AGE_DAYS=60
